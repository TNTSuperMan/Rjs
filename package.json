{
  "name": "@tntsuperman/rjs",
  "version": "0.0.9",
  "author": "TNTSuperMan",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TNTSuperMan/Rjs"
  },
  "main": "dist/cjs.js",
  "module": "dist/esm.js",
  "devDependencies": {
    "@types/bun": "^1.2.11",
    "happy-dom": "^17.4.6"
  },
  "description": "simple, react, fast JavaScript framework",
  "homepage": "https://tntsuperman.github.io/Rjs-homepage/",
  "license": "MIT",
  "scripts": {
    "build": "tsc && bun build:esm && bun build:cjs",
    "build:esm": "bun build --outdir=dist --minify --format=esm --entry-naming=esm.js ./src/index.ts",
    "build:cjs": "bun build --outdir=dist --minify --format=cjs --entry-naming=cjs.js ./src/index.ts"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
